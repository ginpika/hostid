{
  "name": "hostid",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "dev:desktop": "npm run dev --workspace=desktop",
    "build": "npm run build --workspace=frontend",
    "build:desktop": "npm run build --workspace=desktop",
    "typecheck": "npm run typecheck --workspace=frontend",
    "test": "npm run test --workspace=frontend && npm --prefix backend test"
  }
}
