{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HostID",
  "version": "0.5.0",
  "identifier": "com.hostid.mail",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "HostID Desktop Client",
    "longDescription": "Self-hosted email workspace and unified SSO desktop client for HostID instances."
  }
}
