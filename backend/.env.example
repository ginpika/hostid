# ===========================================
# Backend Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# ----- Database -----
# SQLite database URL (for development)
DATABASE_URL="file:./prod.db"

# ----- Security -----
# JWT secret key for authentication tokens
# Generate a secure random string for production
# REQUIRED, at least 32 characters; the server refuses to start otherwise.
# Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# Data encryption key (AES-256-GCM for OAuth client secrets and fused-mail tokens),
# separate from JWT_SECRET. At least 32 characters: openssl rand -base64 48
# If unset, the legacy JWT_SECRET-derived key is used (a warning is logged).
# Existing ciphertext encrypted with the legacy key is still decrypted after you set this,
# so do NOT change JWT_SECRET until all data has been re-encrypted.
DATA_ENCRYPTION_KEY=""

# CORS allowlist uses FRONTEND_URL (comma-separated for multiple origins, e.g.
# "https://mail.example.com,https://admin.example.com").
# Extra allowed origins (e.g. other SSO sites calling /api/sso with credentials):
# CORS_ALLOWED_ORIGINS="https://app.example.com"

# ----- Server -----
# API server port (default: 3001)
# Split-image Compose fixes HTTP at 3001 (host: BACKEND_PORT).
# hostid-full fixes HTTP at 3000 (host: FRONTEND_PORT).
PORT=3001

# SSO login page URL for redirects (e.g., https://mail.a.com/login)
# this is the url that the frontend will redirect to after login success
SSO_LOGIN_PAGE_URL=https://mail.your-domain.com/login

# Your mail domain (e.g., example.com)
MAIL_DOMAIN="your-domain.com"

# ----- SMTP Server (Receiving Emails) -----
# Internal port for incoming SMTP connections (Docker Compose also fixes it at 2525).
# Compose publishes host port 25 by default; set SMTP_PORT in the Compose .env to change the host port.
SMTP_PORT=2525

# ----- SMTP Relay (Sending External Emails) -----
# Optional: Configure if you want to relay emails through an external SMTP server
# If not configured, the system will attempt direct delivery via MX records

# SMTP relay server hostname
SMTP_HOST=

# SMTP relay server port (default: 25)
SMTP_OUT_PORT=25

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
SMTP_PASS=

# ----- Cloudflare Turnstile (Optional) -----
# Bot protection for registration page
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile

# Cloudflare Turnstile Secret Key (server-side verification), if not set, turnstile will be disabled
# CF_TURNSTILE_SECRET_KEY="YourTurnstileSecretKey"
# hostid-full only: the public site key is served to the browser through /config.js.
# CF_TURNSTILE_SITE_KEY="YourTurnstileSiteKey"

# ----- SSO Configuration -----
# Cookie domain for SSO (e.g., .example.com for all subdomains)
# Leave empty for single domain deployment
SSO_COOKIE_DOMAIN=gmail.com

# Cookie name for SSO token
SSO_COOKIE_NAME=sso_token

# Cookie path (default: /)
SSO_COOKIE_PATH=/

# Cookie secure flag (true for HTTPS, false for HTTP)
SSO_COOKIE_SECURE=false

# Cookie sameSite attribute (strict, lax, none)
SSO_COOKIE_SAMESITE=lax

# Session TTL in seconds (default: 7 days)
SESSION_TTL=604800

# Frontend URL for OAuth
FRONTEND_URL=https://mail.your-domain.com

# Fused mail (see docs/fused-mail.md)
# OAuth callback for fused mail (default: FRONTEND_URL/api/fused-mail/oauth/callback)
# FUSED_MAIL_CALLBACK_URL=https://mail.your-domain.com/api/fused-mail/oauth/callback
# Number of recent messages fetched on the first sync of an account (default: 200)
# FUSED_MAIL_INITIAL_SYNC_LIMIT=200
