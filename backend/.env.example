# ===========================================
# HostID backend — OPTIONAL overrides
# ===========================================
# Nothing here is required. A fresh install starts with no configuration:
#   1. open the site and complete the first-run setup (/setup)
#   2. configure site URL, mail domain, SMTP relay, Turnstile, SSO cookies and
#      fused mail in Admin → 系统设置 / System Settings (stored in the database)
#
# Secrets (JWT_SECRET, DATA_ENCRYPTION_KEY) are generated automatically on first
# start and saved to <data dir>/secrets.json (mode 0600). Back up that file
# together with the database — without it encrypted data cannot be decrypted.

# ----- Infrastructure -----
# DATABASE_URL="file:./prod.db"   # Docker images use file:/app/data/prod.db
# HOSTID_DATA_DIR=/app/data       # where secrets.json lives (default: database directory)
# PORT=3001
# SMTP_PORT=2525

# ----- Secrets (override the auto-generated ones) -----
# At least 32 characters each, e.g. `openssl rand -base64 48`.
# JWT_SECRET=
# DATA_ENCRYPTION_KEY=

# ----- Legacy settings (imported once) -----
# Older deployments configured these via env. On first start after upgrading, any of
#   FRONTEND_URL, CORS_ALLOWED_ORIGINS, SSO_LOGIN_PAGE_URL, MAIL_DOMAIN,
#   SMTP_HOST, SMTP_OUT_PORT, SMTP_USER, SMTP_PASS,
#   CF_TURNSTILE_SITE_KEY, CF_TURNSTILE_SECRET_KEY,
#   SSO_COOKIE_DOMAIN, SSO_COOKIE_NAME, SSO_COOKIE_PATH, SSO_COOKIE_SECURE,
#   SSO_COOKIE_SAMESITE, SESSION_TTL, SSO_RATE_MAX, SSO_RATE_WINDOW_MS,
#   FUSED_MAIL_CALLBACK_URL, FUSED_MAIL_INITIAL_SYNC_LIMIT
# that are set are copied into the database; afterwards the Settings page is the
# source of truth and these variables can be removed.
